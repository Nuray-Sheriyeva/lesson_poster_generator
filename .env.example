# OpenAI credentials. One key covers OCR, the default planner, image generation,
# and verification.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional Langfuse tracing (pip install 'genlesson[tracing]'). Tracing is on
# automatically when both credentials are present; use --no-tracing to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Legacy runtime overrides. These still work when exported, but config.toml is
# the recommended place for model and default settings.
GENLESSON_VISION_MODEL=gpt-6-luna
GENLESSON_RENDER_DPI=180
GENLESSON_PLANNER_MODEL=gpt-6-luna
GENLESSON_MAX_PAGE_IMAGES=6
GENLESSON_MAX_DETAILS=8
GENLESSON_CONTEXT_CHARS=24000
GENLESSON_CHUNK_CHARS=12000
GENLESSON_IMAGE_MODEL=gpt-image-2
GENLESSON_FORMATS=portrait
GENLESSON_IMAGE_TIMEOUT=180
GENLESSON_IMAGE_RETRIES=3
GENLESSON_VERIFY_MODEL=
GENLESSON_VERIFY_SIMILARITY=0.9
GENLESSON_VERIFY_RETRIES=2
GENLESSON_VERIFY_TIMEOUT=120
GENLESSON_VERIFY_VISION_RETRIES=3

# Preferred POSTER_* overrides. config.toml is the source of defaults.
# POSTER_CONFIG=config.toml
# POSTER_REVIEW=off
# POSTER_REVIEW_ON_CONFLICT=0
# POSTER_PLANNER_PROVIDER=openai
# POSTER_PLANNER_MODEL=gpt-6-luna
# POSTER_PLANNER_MAX_CONTEXT=1050000
# POSTER_IMAGE_PROVIDER=openai
# POSTER_IMAGE_MODEL=gpt-image-2
# POSTER_MAX_DETAILS=8
# POSTER_MAX_RETRIES=2
# POSTER_OUT_DIR=outputs

# Optional planner providers. Image generation still uses OpenAI.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# POSTER_ANTHROPIC_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# POSTER_DEEPSEEK_MODEL=
